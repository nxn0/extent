{
  "manifest_version": 3,
  "name": "Video Viewport",
  "version": "0.1.0",
  "description": "Open a YouTube video in a clean player-only browser tab.",
  "permissions": ["activeTab", "scripting"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "scripts": ["src/core.js", "src/background.js"]
  },
  "action": {
    "default_title": "Video Viewport",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "video-viewport@example.org",
      "strict_min_version": "128.0"
    }
  }
}